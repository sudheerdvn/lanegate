{
  "repo_root": "/home/operator/lanegate-dev",
  "ticket_prefix": "TICK",
  "tickets_dir": ".lanegate/tickets",
  "worktrees_dir": ".lanegate/worktrees",
  "executor": "claude",
  "executor_steps": {
    "review": "codex-1"
  },
  "executors": {
    "claude-1": {
      "type": "claude-process",
      "api_key_env": "ANTHROPIC_API_KEY_1",
      "max_parallel": 2
    },
    "codex-1": {
      "type": "codex",
      "api_key_env": "OPENAI_API_KEY_1",
      "max_parallel": 1
    }
  },
  "models": {
    "claude": "claude-sonnet-5",
    "codex": "gpt-5-codex"
  },
  "max_parallel": 3,
  "default_milestone": "v1.6",
  "on_rate_limit": "halt",
  "github_pr": true,
  "commit_status_changes": true,
  "environments": [
    {
      "name": "staging",
      "branch": "staging",
      "from": "main",
      "trigger": "auto",
      "sync": "ff-only"
    },
    {
      "name": "production",
      "branch": "production",
      "from": "staging",
      "trigger": "manual",
      "sync": "ff-only"
    }
  ],
  "api": {
    "host": "127.0.0.1",
    "port": 8000
  }
}
